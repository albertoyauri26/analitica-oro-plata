# Copia este archivo como .env. No publiques .env ni compartas sus valores.
GEMINI_API_KEY=
# Modelo configurable; comprueba su disponibilidad en tu cuenta de Google AI Studio.
GEMINI_MODEL=gemini-3.6-flash
# auto: Gemini y, ante el primer fallo del lote, API local FinBERT.
# Opciones: auto, gemini, finbert. Las noticias ya analizadas se reutilizan.
SENTIMENT_PROVIDER=auto
SENTIMENT_LOCAL_URL=http://127.0.0.1:8766
