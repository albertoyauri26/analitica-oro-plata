# Copia este archivo como .env. No publiques .env ni compartas sus valores.
GEMINI_API_KEY=
# Modelo configurable; comprueba su disponibilidad en tu cuenta de Google AI Studio.
GEMINI_MODEL=gemini-3.6-flash
# mistral o gemini: sólo ese LLM, sin FinBERT; si falla, las noticias quedan pendientes.
# auto: Gemini y, ante el fallo del lote, API local FinBERT. finbert: sólo local.
# Las noticias ya analizadas se reutilizan.
SENTIMENT_PROVIDER=mistral
# Clave de console.mistral.ai. Plan gratuito "Experiment": sin tarjeta; incluye ministral-14b-2512 (30/min).
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-2512
MISTRAL_MIN_INTERVAL=3
MISTRAL_ATTEMPTS=3
SENTIMENT_LOCAL_URL=http://127.0.0.1:8766
# Segundos entre noticias enviadas a Gemini (nivel gratuito: ~5 por minuto) e intentos ante HTTP 503.
# Cada intento fallido también consume la cuota diaria del nivel gratuito (20 por modelo).
GEMINI_MIN_INTERVAL=13
GEMINI_ATTEMPTS=3
